{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finpath lesson",
  "type": "object",
  "required": ["id", "title", "description", "minutes", "icon", "questions"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/definitions/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "icon": {
      "enum": ["chart", "radar", "layers", "bolt", "book"]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/question"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "topic",
        "prompt",
        "explanation",
        "detail",
        "misconception",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": [
            "multiple-choice",
            "true-false",
            "numerical",
            "matching",
            "sequence"
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "misconception": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "required": ["file", "section", "kind"],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": ["adapted", "original-application"]
            }
          }
        },
        "table": {
          "type": "object",
          "required": ["headers", "rows"],
          "additionalProperties": false,
          "properties": {
            "headers": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "answer": {},
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "left", "right"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "left": {
                "type": "string",
                "minLength": 1
              },
              "right": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "absoluteTolerance": {
          "type": "number",
          "minimum": 0
        },
        "relativeTolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple-choice"
              }
            }
          },
          "then": {
            "required": ["options", "answer"],
            "properties": {
              "answer": {
                "$ref": "#/definitions/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "true-false"
              }
            }
          },
          "then": {
            "required": ["answer"],
            "properties": {
              "answer": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "numerical"
              }
            }
          },
          "then": {
            "required": [
              "answer",
              "unit",
              "absoluteTolerance",
              "relativeTolerance"
            ],
            "properties": {
              "answer": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sequence"
              }
            }
          },
          "then": {
            "required": ["items", "answer"],
            "properties": {
              "answer": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/definitions/id"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matching"
              }
            }
          },
          "then": {
            "required": ["pairs"]
          }
        }
      ]
    }
  }
}
